# Postgres connection string used by the server, migrations, user CLI and backups
DB_CONNECTION=postgresql://prinzeugen:change-me@127.0.0.1:5432/prinzeugen

# Port the bun server listens on (nginx proxies to it)
PORT=7780

# Public origin of the deployed dashboard. Used to build image proxy URLs handed to Telegram.
PUBLIC_URL=https://example.com

# Bot used for failure reports and backups, and the chat id that receives them
TG_TOKEN=
TG_TARGET_ME=

# Optional SOCKS5/HTTP proxy for outbound gelbooru media fetches (/resize, HEAD pings).
# Leave empty to connect directly. Example: socks5://127.0.0.1:9050
OUTBOUND_PROXY=

# Optional comma-separated list of extra origins allowed to call /api (CORS).
# Not needed when the dashboard is served by this server or the same nginx host.
CORS_ORIGIN=

# Hosts /resize is allowed to fetch from (suffix match, comma-separated)
RESIZE_HOSTS=gelbooru.com
